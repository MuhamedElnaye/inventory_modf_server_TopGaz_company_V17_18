<odoo>
    <data>
        <!-- تعديل في فورم المنتج -->
        <record id="view_product_form_inherit_cost_tax" model="ir.ui.view">
            <field name="name">product.template.form.inherit.cost.tax</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <!-- نضيف الحقل الجديد بعد حقل standard_price -->
                <xpath expr="//group//group[2]//field[@name='categ_id']" position="before">
                    <field name="cost_with_tax" widget="monetary" options="{'currency_field': 'currency_id'}"
                           readonly="1" string="Cost + Purchase Taxes"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>