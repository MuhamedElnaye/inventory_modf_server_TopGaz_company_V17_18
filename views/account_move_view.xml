<odoo>
    <record id="view_move_tree_inherit_customer_ref" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.customer.ref</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_credit_note_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="customer_ref" string="Customer_Ref" optional="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_move_form_inherit_customer_ref" model="ir.ui.view">
        <field name="name">account.move.form.inherit.customer.ref</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group//group[last()]" position="inside">
                <field name="customer_ref"/>
            </xpath>
        </field>
    </record>
</odoo>